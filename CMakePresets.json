{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "hidden": true,
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_C_STANDARD": "11",
                "CMAKE_CXX_STANDARD": "20",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "LOGGER_TYPE": "hydrolib"
            }
        },
        {
            "name": "host",
            "hidden": true,
            "inherits": "default"
        },
        {
            "name": "target",
            "hidden": true,
            "inherits": "default",
            "cacheVariables": {
                "BUILD_TESTING": "OFF"
            }
        },
        {
            "name": "F4",
            "inherits": "target",
            "hidden": true,
            "toolchainFile": "${sourceDir}/resources/gcc-arm-none-eabi-f4.cmake",
            "cacheVariables": {
                "CMAKE_C_FLAGS": "-DSTM32F407xx",
                "CMAKE_CXX_FLAGS": "-DSTM32F407xx",
                "MCU_FAMILY": "F4"
            }
        },
        {
            "name": "F1",
            "inherits": "target",
            "hidden": true,
            "toolchainFile": "${sourceDir}/resources/gcc-arm-none-eabi-f1.cmake",
            "cacheVariables": {
                "CMAKE_C_FLAGS": "-DSTM32F103xB",
                "CMAKE_CXX_FLAGS": "-DSTM32F103xB",
                "MCU_FAMILY": "F1"
            }
        },
        {
            "name": "Debug",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "BUILD_TESTS": "ON",
                "BUILD_TESTING": "OFF",
                "HYDRV_BUILD_EXAMPLES": "OFF",
                "HYDRV_BUILD_MODULES": "hydrv_uart",
                "MCU_FAMILY": "F4",
                "RUN_TESTS": "OFF"
            }
        },
        {
            "name": "RelWithDebInfo",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        },
        {
            "name": "Release",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "MinSizeRel",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "MinSizeRel"
            }
        },
        {
            "name": "DebugF4",
            "inherits": "F4",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "HYDRV_BUILD_EXAMPLES": "ON"
            }
        },
        {
            "name": "DebugF1",
            "inherits": "F1",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "HYDRV_BUILD_EXAMPLES": "ON"
            }
        },
        {
            "name": "RenodeF4",
            "inherits": "DebugF4",
            "cacheVariables": {
                "RUN_TESTS": "ON"
            }
        },
        {
            "name": "RenodeF1",
            "inherits": "DebugF1",
            "cacheVariables": {
                "RUN_TESTS": "ON"
            }
        },
        {
            "name": "Testing",
            "inherits": "Debug"
        }
    ],
    "buildPresets": [
        {
            "name": "Debug",
            "configurePreset": "Debug"
        },
        {
            "name": "RelWithDebInfo",
            "configurePreset": "RelWithDebInfo"
        },
        {
            "name": "Release",
            "configurePreset": "Release"
        },
        {
            "name": "MinSizeRel",
            "configurePreset": "MinSizeRel"
        },
        {
            "name": "DebugF4",
            "configurePreset": "DebugF4"
        },
        {
            "name": "DebugF1",
            "configurePreset": "DebugF1"
        },
        {
            "name": "RenodeF4",
            "configurePreset": "RenodeF4"
        },
        {
            "name": "RenodeF1",
            "configurePreset": "RenodeF1"
        },
        {
            "name": "Testing",
            "configurePreset": "Testing"
        }
    ],
    "testPresets": [
        {
            "name": "RenodeF4",
            "configurePreset": "RenodeF4",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "RenodeF1",
            "configurePreset": "RenodeF1",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "Testing",
            "configurePreset": "Testing",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
